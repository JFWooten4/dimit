    "pwm.repinned": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brightness was re‑pinned to 100%. Use the slider in the app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Яркость снова зафиксирована на 100%. Используйте ползунок в приложении."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorqinlik yana 100% ga qaytarildi. Ilova ichidagi slayderdan foydalaning."
          }
        }
      }
    },
    "pwm.unsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PWM‑Safe needs an Apple display or a DDC/CI monitor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для режима без мерцания нужен дисплей Apple или монитор с DDC/CI."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "PWM‑xavfsiz rejim uchun Apple displeyi yoki DDC/CI monitor kerak."
          }
        }
      }
    },
