    "onboarding.1.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two sliders, three presets, one button."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два ползунка, три режима, одна кнопка."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikki slayder, uch rejim, bitta tugma."
          }
        }
      }
    },
    "onboarding.1.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block blue light. Stop the flicker."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уберите синий свет. Остановите мерцание."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko'k nurni to'sing. Miltillashni to'xtating."
          }
        }
      }
    },
    "onboarding.2.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshots, recordings and calls keep their normal colours."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Скриншоты, записи и звонки сохраняют обычные цвета."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skrinshotlar, yozuvlar va qo'ng'iroqlar oddiy ranglarini saqlaydi."
          }
        }
      }
    },
    "onboarding.2.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your screenshots stay normal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скриншоты остаются обычными"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrinshotlar oddiy qoladi"
          }
        }
      }
    },
    "onboarding.3.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account, no analytics, no tracking. Dimit connects to the internet only if you turn on update checks."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Без аккаунта, без аналитики, без слежки. Dimit выходит в интернет, только если вы включите проверку обновлений."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Akkaunt yo'q, analitika yo'q, kuzatuv yo'q. Dimit internetga faqat siz yangilanishlarni tekshirishni yoqsangiz ulanadi."
          }
        }
      }
    },
    "onboarding.3.title": {
      "localizations": {
        "en": {
