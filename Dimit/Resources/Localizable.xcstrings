    "schedule.transition": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fade over"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Плавный переход за"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O'tish vaqti"
          }
        }
      }
    },
    "schedule.transition_help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How gradually Dimit moves between DAY, EVENING and NIGHT. A longer fade is less noticeable while you are working; set it to 0 to switch instantly."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Насколько плавно Dimit переходит между режимами ДЕНЬ, ВЕЧЕР и НОЧЬ. Долгий переход меньше отвлекает во время работы; поставьте 0, чтобы переключалось сразу."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dimit KUN, KECH va TUN o'rtasida qanchalik asta o'zgarishi. Uzunroq o'tish ishlayotganda unchalik sezilmaydi; darhol o'zgarishi uchun 0 qiling."
          }
        }
      }
    },
    "schedule.use_location": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use my location"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Использовать моё местоположение"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Joylashuvimdan foydalanish"
          }
        }
      }
    },
