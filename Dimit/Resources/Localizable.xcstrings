          }
        }
      }
    },
    "schedule.bell_help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start dim at wake-up, brighten smoothly to your peak, then fade back down by bedtime. Night warmth follows your NIGHT preset."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Тусклый свет при пробуждении плавно усиливается до пика и снижается ко сну. Ночная теплота — из пресета NIGHT."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uyg‘onishda xira yorug‘lik asta-sekin eng yuqori darajaga ko‘tarilib, uyqu vaqtigacha pasayadi. Tungi iliqlik NIGHT sozlamasidan olinadi."
          }
        }
      }
    },
    "schedule.bell_invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Peak time must fall between wake-up and bedtime. Bedtime may be after midnight."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пик должен быть между пробуждением и сном. Время сна может быть после полуночи."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eng yorqin vaqt uyg‘onish va uyqu orasida bo‘lishi kerak. Uyqu vaqti yarim tundan keyin bo‘lishi mumkin."
          }
        }
      }
    },
