    "settings.launch_at_login_move_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If Dimit is running from the disk image or your Downloads folder, move it to your Applications folder and try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Если Dimit запущен из образа диска или папки «Загрузки», переместите его в папку «Программы» и попробуйте снова."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agar Dimit disk tasviridan yoki Yuklamalar papkasidan ishlayotgan bo'lsa, uni Dasturlar papkasiga ko'chiring va qayta urinib ko'ring."
          }
        }
      }
