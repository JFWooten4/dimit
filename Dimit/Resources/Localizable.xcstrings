    "settings.ddc_experimental": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DDC/CI brightness control (Experimental)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Управление яркостью по DDC/CI (экспериментально)"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "DDC/CI yorqinlik boshqaruvi (tajribaviy)"
          }
        }
      }
    },
    "settings.ddc_help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets PWM-Safe mode pin the backlight on third-party external monitors over DDC/CI. Off by default and not yet confirmed working on any monitor — turn it on only if you're willing to report what happens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Позволяет режиму без мерцания удерживать подсветку сторонних мониторов через DDC/CI. Выключено по умолчанию и пока не подтверждено ни на одном мониторе — включайте, только если готовы сообщить о результате."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PWM-xavfsiz rejimga tashqi monitorlarning orqa yoritishini DDC/CI orqali ushlab turishga imkon beradi. Sukut bo'yicha o'chiq va hali birorta monitorda ishlashi tasdiqlanmagan — faqat natijani xabar qilishga tayyor bo'lsangiz yoqing."
          }
        }
      }
    },
    "settings.ddc_single_display_only": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only used when exactly one external monitor is connected — with several, Dimit can't yet tell which is which and leaves them alone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Используется, только когда подключён ровно один внешний монитор — при нескольких Dimit пока не может их различить и не трогает их."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faqat bitta tashqi monitor ulanganida ishlatiladi — bir nechtasi bo'lsa, Dimit hali qaysi biri qaysiligini ajrata olmaydi va ularga tegmaydi."
          }
        }
      }
    },
