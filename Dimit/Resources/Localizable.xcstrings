    "schedule.manual_help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimit changes only when you change it. Choose Sunset to sunrise to follow the sun where you are, or Fixed times to use your own hours."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dimit меняется только когда вы сами его меняете. Выберите «От заката до рассвета», чтобы следовать за солнцем, или «Заданное время» для своего расписания."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dimit faqat siz o'zgartirganda o'zgaradi. Quyosh bo'yicha ishlashi uchun \"Quyosh botishidan chiqishigacha\", o'z vaqtingiz bo'yicha ishlashi uchun \"Belgilangan vaqt\" ni tanlang."
          }
        }
      }
    },
